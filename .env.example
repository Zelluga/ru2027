# ===== Telegram Mini App «2027» — конфигурация =====
# Скопируйте этот файл в .env и заполните значения.

# Токен Telegram-бота из BotFather (ОБЯЗАТЕЛЕН для валидации initData)
BOT_TOKEN=

# Владелец: username без учёта регистра (по умолчанию Depenz)
OWNER_USERNAME=Depenz

# Telegram ID владельца (рекомендуется зафиксировать, на случай смены username)
OWNER_TG_ID=

# Белый список Telegram ID участников через запятую (опционально; пусто = без ограничения)
# Пример: ALLOWED_TG_IDS=111111,222222,333333,444444,555555,666666
ALLOWED_TG_IDS=

# Адрес и порт HTTP-сервера
HOST=0.0.0.0
PORT=8787

# Путь к файлу БД SQLite (относительно корня проекта)
DB_PATH=./data/app.db

# Максимальный допустимый возраст initData в секундах (по умолчанию 24 часа)
AUTH_MAX_AGE_SECONDS=86400

# 1 = пропустить проверку подписи initData (ТОЛЬКО для локальной разработки; НЕ включать в проде)
DEV_MODE=0
